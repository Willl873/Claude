//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  CONFLUENCE PRE-TRADE CHECKLIST — STRATEGY (backtest twin, v3)
//
//  Same two modes and 12 weighted checks as the indicator
//  (confluence-pretrade-checklist.pine — keep the check logic in sync).
//
//  • MEAN REVERSION (default): enters on panic-dip GO verdicts, exits on the
//    snap-back — close beyond the 5-SMA, RSI(2) recovery, or a time stop —
//    with a wide 3×ATR disaster stop. Designed for the 70–85% win-rate zone
//    on daily index ETFs (NOT guaranteed; measure it here).
//  • TREND: ATR stop / R-multiple target exits (win rate will be much lower
//    by construction; judge it on expectancy, not accuracy).
//
//  Use the Strategy Tester to verify BOTH win rate and profit factor /
//  expectancy, and add commissions + slippage in Properties before trusting
//  any numbers. Educational tool only — not financial advice.
// ─────────────────────────────────────────────────────────────────────────────
strategy("Confluence Checklist Strategy", shorttitle = "Checklist Strat",
     overlay = true, initial_capital = 25000, process_orders_on_close = true,
     default_qty_type = strategy.fixed, calc_on_every_tick = false)

// ═════════════════════════════ INPUTS ════════════════════════════════════════
grpGen  = "General"
tradeMode   = input.string("Mean Reversion", "Mode", options = ["Mean Reversion", "Trend"], group = grpGen)
minScorePct = input.float(65.0, "Min weighted score % for entry", minval = 10, maxval = 100, step = 5, group = grpGen)
allowLong   = input.bool(true,  "Allow longs",  group = grpGen)
allowShort  = input.bool(true,  "Allow shorts", group = grpGen)

grpReg = "Regime & trend"
regimeLen  = input.int(200, "Regime SMA length", minval = 10, group = grpReg)
emaFastLen = input.int(50,  "Fast EMA (Trend mode)", minval = 1, group = grpReg)
emaSlowLen = input.int(200, "Slow EMA (Trend mode)", minval = 1, group = grpReg)

grpHtf = "Higher-timeframe confirmation"
htfTf = input.timeframe("W", "Confirmation timeframe", group = grpHtf)

grpMR = "Mean Reversion mode"
mrRsiLen     = input.int(2,  "RSI length", minval = 1, group = grpMR)
mrRsiOs      = input.float(10, "RSI oversold (long entry)",  minval = 1, maxval = 49, group = grpMR)
mrRsiOb      = input.float(90, "RSI overbought (short entry)", minval = 51, maxval = 99, group = grpMR)
ibsLow       = input.float(0.2, "IBS low (long)",  minval = 0.05, maxval = 0.5, step = 0.05, group = grpMR)
ibsHigh      = input.float(0.8, "IBS high (short)", minval = 0.5, maxval = 0.95, step = 0.05, group = grpMR)
bbLen        = input.int(20, "Bollinger length", minval = 2, group = grpMR)
bbMult       = input.float(2.0, "Bollinger st-dev", minval = 0.5, step = 0.25, group = grpMR)
wprLen       = input.int(14, "Williams %R length", minval = 2, group = grpMR)
wprOs        = input.float(-80, "Williams %R oversold", maxval = -50, group = grpMR)
wprOb        = input.float(-20, "Williams %R overbought", minval = -50, group = grpMR)
consecN      = input.int(2, "Consecutive closes required", minval = 1, maxval = 6, group = grpMR)
exitSmaLen   = input.int(5, "Snap-back SMA length", minval = 2, group = grpMR)
rsiExitLvl   = input.float(65, "RSI exit level (long)", minval = 50, maxval = 95, group = grpMR)
timeStopBars = input.int(5, "Time stop (bars)", minval = 1, group = grpMR)
mrStopAtr    = input.float(3.0, "Disaster stop (× ATR)", minval = 0.5, step = 0.25, group = grpMR)
adxMrMax     = input.float(30.0, "Max ADX (skip runaway trends)", minval = 10, group = grpMR)

grpTr = "Trend mode"
rsiLen   = input.int(14, "RSI length", minval = 1, group = grpTr)
rsiOb    = input.int(70, "RSI overbought", minval = 50, group = grpTr)
rsiOs    = input.int(30, "RSI oversold",   maxval = 50, group = grpTr)
divLbL   = input.int(5,  "Divergence pivot left bars",  minval = 1, group = grpTr)
divLbR   = input.int(2,  "Divergence pivot right bars", minval = 1, group = grpTr)
divValid = input.int(14, "Divergence valid for (bars)", minval = 1, group = grpTr)
macdFast = input.int(12, "MACD fast",   minval = 1, group = grpTr)
macdSlow = input.int(26, "MACD slow",   minval = 1, group = grpTr)
macdSig  = input.int(9,  "MACD signal", minval = 1, group = grpTr)
stLen    = input.int(10, "SuperTrend ATR period", minval = 1, group = grpTr)
stMult   = input.float(3.0, "SuperTrend factor", minval = 0.5, step = 0.25, group = grpTr)
adxThresh = input.float(20.0, "Min ADX (trend strength)", minval = 5, group = grpTr)
atrStop  = input.float(1.5, "Stop distance (× ATR)", minval = 0.1, step = 0.1, group = grpTr)
rrTarget = input.float(2.0, "Target (R multiple)",   minval = 0.5, step = 0.5, group = grpTr)

grpVwap = "VWAP (Trend mode check)"
vwapAnchor = input.string("Auto", "Anchor", options = ["Auto", "Session", "Week", "Month", "Year"], group = grpVwap)

grpFib = "Fibonacci (Trend mode check)"
usePivotFib = input.bool(true, "Anchor to confirmed pivots", group = grpFib)
fibPivLen   = input.int(10, "Pivot strength (bars each side)", minval = 2, group = grpFib)
fibLen      = input.int(100, "Fallback swing lookback (bars)", minval = 10, group = grpFib)
fibTolAtr   = input.float(0.5, "Level proximity tolerance (× ATR)", minval = 0.1, step = 0.1, group = grpFib)

grpVix = "Volatility index"
vixAuto       = input.bool(true, "Auto-select by symbol", group = grpVix)
vixSym        = input.symbol("CBOE:VIX", "Manual symbol", group = grpVix)
vixFearMin    = input.float(30.0, "Fear above (Trend-mode gate)", group = grpVix)
vixCrashMax   = input.float(45.0, "Panic above (MR-mode gate)", group = grpVix)
vixStretchLen = input.int(10, "VIX stretch SMA length (MR check)", minval = 2, group = grpVix)

grpCdl = "Candlestick patterns"
cdlLookback = input.int(3, "Pattern valid for (bars)", minval = 1, maxval = 10, group = grpCdl)

grpTime = "Session filter (intraday only)"
useSession   = input.bool(false, "Restrict entries to a session window", group = grpTime)
sessWindow   = input.session("0930-1600", "Allowed session", group = grpTime)
skipOpenMins = input.int(15, "Skip first minutes after open", minval = 0, group = grpTime)

grpW = "Check weights (0 disables) — MR row ⁄ Trend row"
w1  = input.float(1.0, "1 · Regime",                    minval = 0, maxval = 3, step = 0.5, group = grpW)
w2  = input.float(1.0, "2 · HTF trend",                 minval = 0, maxval = 3, step = 0.5, group = grpW)
w3  = input.float(1.0, "3 · RSI",                       minval = 0, maxval = 3, step = 0.5, group = grpW)
w4  = input.float(1.0, "4 · IBS ⁄ Divergence",          minval = 0, maxval = 3, step = 0.5, group = grpW)
w5  = input.float(1.0, "5 · Bollinger %B ⁄ MACD",       minval = 0, maxval = 3, step = 0.5, group = grpW)
w6  = input.float(1.0, "6 · Williams %R ⁄ SuperTrend",  minval = 0, maxval = 3, step = 0.5, group = grpW)
w7  = input.float(1.0, "7 · Consec closes ⁄ VWAP",      minval = 0, maxval = 3, step = 0.5, group = grpW)
w8  = input.float(1.0, "8 · 5-SMA stretch ⁄ Fibonacci", minval = 0, maxval = 3, step = 0.5, group = grpW)
w9  = input.float(1.0, "9 · VIX stretch ⁄ VIX calm",    minval = 0, maxval = 3, step = 0.5, group = grpW)
w10 = input.float(1.0, "10 · ADX",                      minval = 0, maxval = 3, step = 0.5, group = grpW)
w11 = input.float(1.0, "11 · Candlestick",              minval = 0, maxval = 3, step = 0.5, group = grpW)
w12 = input.float(1.0, "12 · Volume",                   minval = 0, maxval = 3, step = 0.5, group = grpW)

grpVeto = "Veto checks (must pass or no entry)"
vetoRegime = input.bool(true, "Regime is required",    group = grpVeto)
vetoHtf    = input.bool(true, "HTF trend is required", group = grpVeto)
vetoVix    = input.bool(true, "VIX panic gate",        group = grpVeto)

grpRisk = "Risk & sizing"
atrLen  = input.int(14, "ATR length", minval = 1, group = grpRisk)
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.05, step = 0.25, group = grpRisk)

// ═════════════════════════ CHECKS (mirror of the indicator) ══════════════════
isMR   = tradeMode == "Mean Reversion"
atrVal = ta.atr(atrLen)
hasVol = not na(volume)

// Row 1 · Regime
sma200  = ta.sma(close, regimeLen)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
mrRegBull = close > sma200
mrRegBear = close < sma200
trendBull = close > emaSlow and emaFast > emaSlow
trendBear = close < emaSlow and emaFast < emaSlow
regBull = isMR ? mrRegBull : trendBull
regBear = isMR ? mrRegBear : trendBear

// Row 2 · Higher-timeframe trend
[htfClose, htfFast, htfSlow] = request.security(syminfo.tickerid, htfTf,
     [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen)], lookahead = barmerge.lookahead_off)
htfBull = not na(htfSlow) and htfClose > htfSlow and htfFast > htfSlow
htfBear = not na(htfSlow) and htfClose < htfSlow and htfFast < htfSlow

// Row 3 · RSI
rsi2   = ta.rsi(close, mrRsiLen)
rsiVal = ta.rsi(close, rsiLen)
mrRsiBull = rsi2 < mrRsiOs
mrRsiBear = rsi2 > mrRsiOb
trRsiBull = (rsiVal > 50 and rsiVal < rsiOb) or ta.crossover(rsiVal, rsiOs)
trRsiBear = (rsiVal < 50 and rsiVal > rsiOs) or ta.crossunder(rsiVal, rsiOb)

// Row 4 · IBS / RSI divergence
ibs = (close - low) / math.max(high - low, syminfo.mintick)
ibsBull = ibs < ibsLow
ibsBear = ibs > ibsHigh
plFound = not na(ta.pivotlow(rsiVal, divLbL, divLbR))
phFound = not na(ta.pivothigh(rsiVal, divLbL, divLbR))
bullDivNow = plFound and rsiVal[divLbR] > ta.valuewhen(plFound, rsiVal[divLbR], 1) and low[divLbR]  < ta.valuewhen(plFound, low[divLbR], 1)
bearDivNow = phFound and rsiVal[divLbR] < ta.valuewhen(phFound, rsiVal[divLbR], 1) and high[divLbR] > ta.valuewhen(phFound, high[divLbR], 1)
sinceBullDiv = ta.barssince(bullDivNow)
sinceBearDiv = ta.barssince(bearDivNow)
divBull = not na(sinceBullDiv) and sinceBullDiv <= divValid
divBear = not na(sinceBearDiv) and sinceBearDiv <= divValid

// Row 5 · Bollinger %B / MACD
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
pctB    = bbUpper != bbLower ? (close - bbLower) / (bbUpper - bbLower) : 0.5
pctBBull = pctB < 0.0
pctBBear = pctB > 1.0
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdBull = macdLine > macdSignal and macdHist > macdHist[1]
macdBear = macdLine < macdSignal and macdHist < macdHist[1]

// Row 6 · Williams %R / SuperTrend
wpr = ta.wpr(wprLen)
wprBull = wpr <= wprOs
wprBear = wpr >= wprOb
[stLine, stDir] = ta.supertrend(stMult, stLen)
stBull = stDir < 0
stBear = stDir > 0

// Row 7 · Consecutive closes / VWAP
downStreak = 0
downStreak := close < close[1] ? nz(downStreak[1]) + 1 : 0
upStreak = 0
upStreak := close > close[1] ? nz(upStreak[1]) + 1 : 0
consecBull = downStreak >= consecN
consecBear = upStreak >= consecN
autoTf   = timeframe.isintraday ? "D" : timeframe.isdaily ? "M" : "12M"
anchorTf = vwapAnchor == "Auto" ? autoTf : vwapAnchor == "Session" ? "D" : vwapAnchor == "Week" ? "W" : vwapAnchor == "Month" ? "M" : "12M"
newSession = timeframe.change(anchorTf)
var float sumPV = 0.0
var float sumV  = 0.0
if newSession
    sumPV := 0.0
    sumV  := 0.0
if hasVol
    sumPV += hlc3 * volume
    sumV  += volume
vwapVal  = sumV > 0 ? sumPV / sumV : na
vwapBull = hasVol and not na(vwapVal) and close > vwapVal
vwapBear = hasVol and not na(vwapVal) and close < vwapVal

// Row 8 · 5-SMA stretch / Fibonacci
sma5 = ta.sma(close, exitSmaLen)
smaStretchBull = close < sma5
smaStretchBear = close > sma5
phVal = ta.pivothigh(high, fibPivLen, fibPivLen)
plVal = ta.pivotlow(low, fibPivLen, fibPivLen)
var float pivHi    = na
var int   pivHiBar = na
var float pivLo    = na
var int   pivLoBar = na
if not na(phVal)
    pivHi    := phVal
    pivHiBar := bar_index - fibPivLen
if not na(plVal)
    pivLo    := plVal
    pivLoBar := bar_index - fibPivLen
winHigh  = ta.highest(high, fibLen)
winLow   = ta.lowest(low, fibLen)
hiOffset = ta.highestbars(high, fibLen)
loOffset = ta.lowestbars(low, fibLen)
pivotsOk  = usePivotFib and not na(pivHi) and not na(pivLo) and not na(pivHiBar) and not na(pivLoBar)
swingHigh = pivotsOk ? pivHi : winHigh
swingLow  = pivotsOk ? pivLo : winLow
upSwing   = pivotsOk ? pivHiBar > pivLoBar : hiOffset > loOffset
fibRange  = swingHigh - swingLow
fibLevel(r) => upSwing ? swingHigh - fibRange * r : swingLow + fibRange * r
fibTol = fibTolAtr * atrVal
nearLevel(lvl) => math.abs(close - lvl) <= fibTol
fibNearKey = nearLevel(fibLevel(0.382)) or nearLevel(fibLevel(0.5)) or nearLevel(fibLevel(0.618))
fibBull = upSwing and fibNearKey
fibBear = not upSwing and fibNearKey

// Row 9 · VIX stretch / VIX calm
autoVixSym = syminfo.ticker == "QQQ" or syminfo.ticker == "NDX" or str.contains(syminfo.ticker, "NQ") ? "CBOE:VXN" :
     syminfo.ticker == "IWM" or syminfo.ticker == "RUT" ? "CBOE:RVX" : "CBOE:VIX"
volIdxSym = vixAuto ? autoVixSym : vixSym
[vixClose, vixPct, vixSmaVal] = request.security(volIdxSym, "D", [close, ta.percentrank(close, 252), ta.sma(close, vixStretchLen)], lookahead = barmerge.lookahead_off)
vixCalmOk  = not na(vixClose) and vixClose < vixFearMin
vixPanicOk = not na(vixClose) and vixClose < vixCrashMax
vixStretchBull = not na(vixSmaVal) and vixClose > vixSmaVal
vixStretchBear = not na(vixSmaVal) and vixClose < vixSmaVal

// Row 10 · ADX
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
adxMrOk    = adxVal < adxMrMax
adxTrendOk = adxVal >= adxThresh

// Row 11 · Candlestick patterns
body      = math.abs(close - open)
candRange = math.max(high - low, syminfo.mintick)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
avgBody   = ta.sma(body, 14)
bullEngulf   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body > body[1]
bearEngulf   = close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body > body[1]
hammer       = lowerWick >= 2 * body and upperWick <= 0.3 * candRange and body > 0
shootingStar = upperWick >= 2 * body and lowerWick <= 0.3 * candRange and body > 0
morningStar  = close[2] < open[2] and body[2] > avgBody and body[1] < 0.5 * avgBody and close > open and close > (open[2] + close[2]) / 2
eveningStar  = close[2] > open[2] and body[2] > avgBody and body[1] < 0.5 * avgBody and close < open and close < (open[2] + close[2]) / 2
sinceBull = ta.barssince(bullEngulf or hammer or morningStar)
sinceBear = ta.barssince(bearEngulf or shootingStar or eveningStar)
cdlBull = not na(sinceBull) and sinceBull <= cdlLookback
cdlBear = not na(sinceBear) and sinceBear <= cdlLookback

// Row 12 · Volume confirmation
volSma = ta.sma(volume, 20)
volOk  = hasVol and not na(volSma) and volume > volSma

// Session filter
inSess = not na(time(timeframe.period, sessWindow))
var int sessOpenT = na
if inSess and not inSess[1]
    sessOpenT := time
minsSinceOpen = inSess and not na(sessOpenT) ? (time - sessOpenT) / 60000.0 : 0.0
timeOk = not useSession or not timeframe.isintraday or (inSess and minsSinceOpen >= skipOpenMins)

// ═════════════════════════ SCORING & SIGNALS ═════════════════════════════════
bullChecks = array.from(
     regBull,
     htfBull,
     isMR ? mrRsiBull : trRsiBull,
     isMR ? ibsBull : divBull,
     isMR ? pctBBull : macdBull,
     isMR ? wprBull : stBull,
     isMR ? consecBull : vwapBull,
     isMR ? smaStretchBull : fibBull,
     isMR ? vixStretchBull : vixCalmOk,
     isMR ? adxMrOk : adxTrendOk,
     cdlBull,
     volOk)
bearChecks = array.from(
     regBear,
     htfBear,
     isMR ? mrRsiBear : trRsiBear,
     isMR ? ibsBear : divBear,
     isMR ? pctBBear : macdBear,
     isMR ? wprBear : stBear,
     isMR ? consecBear : vwapBear,
     isMR ? smaStretchBear : fibBear,
     isMR ? vixStretchBear : vixCalmOk,
     isMR ? adxMrOk : adxTrendOk,
     cdlBear,
     volOk)
weights = array.from(w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12)

weightedScore(array<bool> checks, array<float> ws) =>
    float s = 0.0
    for i = 0 to array.size(checks) - 1
        s += array.get(checks, i) ? array.get(ws, i) : 0.0
    s
totalW  = array.sum(weights)
bullPct = totalW > 0 ? 100 * weightedScore(bullChecks, weights) / totalW : 0.0
bearPct = totalW > 0 ? 100 * weightedScore(bearChecks, weights) / totalW : 0.0

vixGateOk   = isMR ? vixPanicOk : vixCalmOk
vetoLongOk  = (not vetoRegime or regBull) and (not vetoHtf or htfBull) and (not vetoVix or vixGateOk)
vetoShortOk = (not vetoRegime or regBear) and (not vetoHtf or htfBear) and (not vetoVix or vixGateOk)

goLong  = timeOk and vetoLongOk  and bullPct >= minScorePct and bullPct > bearPct
goShort = timeOk and vetoShortOk and bearPct >= minScorePct and bearPct > bullPct
longFire  = goLong  and not goLong[1]
shortFire = goShort and not goShort[1]

// ═════════════════════════ ORDERS ════════════════════════════════════════════
stopMult = isMR ? mrStopAtr : atrStop
stopDist = stopMult * atrVal
riskCash = strategy.equity * riskPct / 100
qty      = not na(stopDist) and stopDist > 0 ? math.max(riskCash / stopDist, 1e-8) : na

// Entries (both modes)
if longFire and allowLong and strategy.position_size == 0 and not na(qty)
    strategy.entry("Long", strategy.long, qty = qty)
    if isMR
        strategy.exit("Long stop", "Long", stop = close - stopDist)
    else
        strategy.exit("Long exit", "Long", stop = close - stopDist, limit = close + stopDist * rrTarget)
if shortFire and allowShort and strategy.position_size == 0 and not na(qty)
    strategy.entry("Short", strategy.short, qty = qty)
    if isMR
        strategy.exit("Short stop", "Short", stop = close + stopDist)
    else
        strategy.exit("Short exit", "Short", stop = close + stopDist, limit = close - stopDist * rrTarget)

// Mean-reversion snap-back / time-stop exits
barsInTrade = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : 0
if isMR and strategy.position_size > 0 and (close > sma5 or rsi2 > rsiExitLvl or barsInTrade >= timeStopBars)
    strategy.close("Long", comment = close > sma5 ? "snap-back" : rsi2 > rsiExitLvl ? "rsi-recover" : "time-stop")
if isMR and strategy.position_size < 0 and (close < sma5 or rsi2 < 100 - rsiExitLvl or barsInTrade >= timeStopBars)
    strategy.close("Short", comment = close < sma5 ? "snap-back" : rsi2 < 100 - rsiExitLvl ? "rsi-recover" : "time-stop")

// Context plots
plot(sma200, "Regime SMA", color = color.new(color.purple, 40), linewidth = 2)
plot(isMR ? sma5 : na, "Snap-back SMA", color = color.new(color.yellow, 40))
plot(not isMR ? emaFast : na, "EMA fast", color = color.new(color.orange, 50))
plot(not isMR ? emaSlow : na, "EMA slow", color = color.new(color.blue, 50))
