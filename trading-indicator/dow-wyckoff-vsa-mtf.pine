//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Dow + Wyckoff + VSA + MTF ("DWVM")
//
// One overlay indicator combining four classic price/volume methodologies:
//   1. Dow Theory        — trend from swing structure (HH/HL vs LH/LL + BOS)
//   2. Wyckoff Method    — climaxes, trading ranges, Springs, Upthrusts, SOS/SOW
//   3. Volume Spread Analysis — bar-level supply/demand reads (ND, NS, SV, …)
//   4. Multi-Timeframe   — two higher timeframes on a confluence dashboard
//
// All signals evaluate on confirmed (closed) bars. Swing labels appear
// `Pivot length` bars after the actual swing — that lag is inherent to
// pivot confirmation, not repainting.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Dow + Wyckoff + VSA + MTF", "DWVM", overlay = true,
     max_labels_count = 500, max_boxes_count = 100, max_lines_count = 100)

// ═══════════════════════════════ Inputs ═════════════════════════════════════
grpDow = "Dow Theory — market structure"
showDow     = input.bool(true,  "Show structure visuals",                 group = grpDow)
pivotLen    = input.int(5,      "Pivot length (bars each side)",          minval = 2, maxval = 50, group = grpDow)
showSwings  = input.bool(true,  "Label swing points (HH/HL/LH/LL)",       group = grpDow)
showBos     = input.bool(true,  "Mark breaks of structure (BOS)",         group = grpDow)
showTrendBg = input.bool(true,  "Tint background by trend",               group = grpDow)

grpWy = "Wyckoff"
showWy       = input.bool(true, "Enable Wyckoff module",                  group = grpWy)
arBars       = input.int(10,    "Automatic rally/reaction window (bars)", minval = 3, maxval = 50, group = grpWy)
maxRangeBars = input.int(300,   "Max trading-range lifetime (bars)",      minval = 50, maxval = 500, group = grpWy)
showRangeBox = input.bool(true, "Draw trading-range box",                 group = grpWy)

grpVsa = "Volume Spread Analysis"
showVsa   = input.bool(true,   "Enable VSA module",          group = grpVsa)
volLen    = input.int(20,      "Volume average length",      minval = 5, maxval = 100, group = grpVsa)
spreadLen = input.int(20,      "Spread average length",      minval = 5, maxval = 100, group = grpVsa)
ultraX    = input.float(2.0,   "Ultra-high volume ×average", minval = 1.5, step = 0.1, group = grpVsa)
highX     = input.float(1.5,   "High volume ×average",       minval = 1.1, step = 0.1, group = grpVsa)
lowX      = input.float(0.7,   "Low volume ×average",        minval = 0.1, step = 0.1, group = grpVsa)

grpMtf = "Multi-timeframe"
showDash  = input.bool(true,       "Show MTF dashboard",         group = grpMtf)
htf1Auto  = input.bool(true,       "HTF 1: auto (≈4× chart)",    group = grpMtf)
htf1Fixed = input.timeframe("240", "HTF 1: fixed",               group = grpMtf)
htf2Auto  = input.bool(true,       "HTF 2: auto (≈16× chart)",   group = grpMtf)
htf2Fixed = input.timeframe("D",   "HTF 2: fixed",               group = grpMtf)
dashPos   = input.string("Top right", "Dashboard position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpMtf)
dashSize  = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = grpMtf)

grpSig = "Confluence signals"
showSignals = input.bool(true, "Plot long/short confluence setups", group = grpSig)

// ═══════════════════════════════ Constants ══════════════════════════════════
color COL_BULL = #26a69a
color COL_BEAR = #ef5350
color COL_NEUT = #9598a1
color COL_DIST = #ff9800

// ═══════════════════════════════ Helpers ════════════════════════════════════
f_autoTf(int mult) =>
    int sec = timeframe.in_seconds(timeframe.period) * mult
    timeframe.from_seconds(math.min(sec, timeframe.in_seconds("12M")))

f_tfTxt(string tf) =>
    int s = timeframe.in_seconds(tf)
    int mo = timeframe.in_seconds("1M")
    s % mo == 0 ? str.tostring(s / mo) + "M" :
     s % 604800 == 0 ? str.tostring(s / 604800) + "W" :
     s % 86400 == 0 ? str.tostring(s / 86400) + "D" :
     s % 3600 == 0 ? str.tostring(s / 3600) + "h" :
     s % 60 == 0 ? str.tostring(s / 60) + "m" : str.tostring(s) + "s"

f_trendTxt(int t) =>
    t == 1 ? "▲ Up" : t == -1 ? "▼ Down" : "◆ Range"

f_trendCol(int t) =>
    t == 1 ? COL_BULL : t == -1 ? COL_BEAR : COL_NEUT

f_wyTxt(int w, int t) =>
    switch w
        1 => "Acc. forming"
        2 => "Accumulation"
        3 => "Dist. forming"
        4 => "Distribution"
        5 => "Markup"
        6 => "Markdown"
        => t == 1 ? "Markup" : t == -1 ? "Markdown" : "Neutral"

f_vsaName(int c) =>
    switch c
        1 => "SC"
        2 => "BC"
        3 => "UT"
        4 => "SO"
        5 => "SV"
        6 => "ENR"
        7 => "ND"
        8 => "NS"
        9 => "T"
        => "—"

f_vsaTip(int c) =>
    switch c
        1 => "Selling Climax — wide spread down bar into new lows on ultra-high volume. Panic supply being absorbed; potential end of the markdown."
        2 => "Buying Climax — wide spread up bar into new highs on ultra-high volume. Public buying absorbed by professional selling; potential end of the markup."
        3 => "Upthrust — new high on the bar but a weak close near the lows on high volume. Supply overwhelmed demand at the highs."
        4 => "Shakeout — wide bar into new lows that recovers to close near the highs on high volume. Weak holders flushed; demand present."
        5 => "Stopping Volume — down bar into new lows on ultra-high volume, closing off the lows. Selling being absorbed; watch for a base."
        6 => "Effort vs No Result — ultra-high volume on a narrow spread. The effort produced no progress; the other side is absorbing."
        7 => "No Demand — narrow up bar with volume below the previous two bars. No professional interest in higher prices; bearish in weakness."
        8 => "No Supply — narrow down bar with volume below the previous two bars. Sellers exhausted; bullish in strength."
        9 => "Test — dip below the prior low on low volume with a firm close, inside an uptrend. Successful test of supply; bullish."
        => ""

f_volTxt(int v) =>
    switch v
        0 => "n/a"
        1 => "Low"
        3 => "High"
        4 => "Ultra"
        => "Normal"

// ═══════════════════════════ Shared bar metrics ═════════════════════════════
bool confirmed = barstate.isconfirmed

var bool hasVol = false
if not na(volume) and volume > 0
    hasVol := true

float spread    = high - low
float spreadAvg = ta.sma(spread, spreadLen)
float volAvg    = ta.sma(nz(volume), volLen)
float relVol    = volAvg > 0 ? nz(volume) / volAvg : 0.0
float clsPos    = spread > 0 ? (close - low) / spread : 0.5

bool vUltra = hasVol and relVol >= ultraX
bool vHigh  = hasVol and relVol >= highX
bool vLow   = hasVol and relVol <= lowX and relVol > 0

bool wideS   = spread > spreadAvg * 1.5
bool narrowS = spread < spreadAvg * 0.8
bool upClose = close > close[1]
bool dnClose = close < close[1]
bool closesHigh = clsPos >= 0.7
bool closesLow  = clsPos <= 0.3

bool newHi10 = high >= ta.highest(high, 10)
bool newLo10 = low <= ta.lowest(low, 10)
bool newHi20 = high >= ta.highest(high, 20)
bool newLo20 = low <= ta.lowest(low, 20)

// ══════════════════════ 1 · Dow Theory — market structure ═══════════════════
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSH = na   // most recent confirmed swing high
var float prevSH = na
var float lastSL = na   // most recent confirmed swing low
var float prevSL = na
var int dowTrend = 0    // 1 up · -1 down · 0 range

if confirmed and not na(ph)
    prevSH := lastSH
    lastSH := ph
    if showDow and showSwings
        string swTxt = na(prevSH) ? "H" : lastSH > prevSH ? "HH" : "LH"
        color swCol = na(prevSH) ? COL_NEUT : lastSH > prevSH ? COL_BULL : COL_BEAR
        label.new(bar_index - pivotLen, lastSH, swTxt, style = label.style_label_down,
             color = color.new(swCol, 25), textcolor = color.white, size = size.tiny)

if confirmed and not na(pl)
    prevSL := lastSL
    lastSL := pl
    if showDow and showSwings
        string swTxt = na(prevSL) ? "L" : lastSL > prevSL ? "HL" : "LL"
        color swCol = na(prevSL) ? COL_NEUT : lastSL > prevSL ? COL_BULL : COL_BEAR
        label.new(bar_index - pivotLen, lastSL, swTxt, style = label.style_label_up,
             color = color.new(swCol, 25), textcolor = color.white, size = size.tiny)

bool hhNow = not na(prevSH) and lastSH > prevSH
bool hlNow = not na(prevSL) and lastSL > prevSL
bool haveStruct = not na(prevSH) and not na(prevSL)

// Dow classification at each new confirmed swing: HH+HL = up, LH+LL = down
if confirmed and haveStruct and (not na(ph) or not na(pl))
    dowTrend := hhNow and hlNow ? 1 : not hhNow and not hlNow ? -1 : 0

// Break of structure: a confirmed close beyond the latest swing flips the
// trend without waiting for the next pivot to confirm
bool bosUp = false
bool bosDn = false
if confirmed
    if not na(lastSH) and close > lastSH and dowTrend != 1
        bosUp := true
        dowTrend := 1
    else if not na(lastSL) and close < lastSL and dowTrend != -1
        bosDn := true
        dowTrend := -1

// ══════════════════════ 2 · Volume Spread Analysis ══════════════════════════
bool vsaOn = showVsa and hasVol

// Climax bars are shared with the Wyckoff module, so they only depend on
// volume being available — not on the VSA display toggle
bool scRaw = hasVol and newLo20 and wideS and vUltra and dnClose
bool bcRaw = hasVol and newHi20 and wideS and vUltra and upClose

bool scBar  = vsaOn and scRaw
bool bcBar  = vsaOn and bcRaw
bool utVsa  = vsaOn and not bcBar and newHi10 and closesLow and (vHigh or vUltra)
bool soVsa  = vsaOn and not scBar and newLo10 and closesHigh and (vHigh or vUltra) and wideS
bool svBar  = vsaOn and not scBar and not soVsa and dnClose and vUltra and newLo10 and clsPos >= 0.45
bool enrBar = vsaOn and vUltra and narrowS and not newHi20 and not newLo20
bool ndBar  = vsaOn and upClose and narrowS and not vHigh and nz(volume) < nz(volume[1]) and nz(volume) < nz(volume[2])
bool nsBar  = vsaOn and dnClose and narrowS and not vHigh and nz(volume) < nz(volume[1]) and nz(volume) < nz(volume[2])
bool tstBar = vsaOn and dowTrend == 1 and low < low[1] and vLow and clsPos >= 0.5 and not nsBar

// One signal per bar, strongest first
int vsaCode = scBar ? 1 : bcBar ? 2 : utVsa ? 3 : soVsa ? 4 : svBar ? 5 :
     enrBar ? 6 : ndBar ? 7 : nsBar ? 8 : tstBar ? 9 : 0

var int lastVsa = 0
var int lastVsaBar = na

if confirmed and vsaCode != 0
    lastVsa := vsaCode
    lastVsaBar := bar_index
    bool vBull = vsaCode == 1 or vsaCode == 4 or vsaCode == 5 or vsaCode == 8 or vsaCode == 9
    color vCol = vsaCode == 6 ? COL_NEUT : vBull ? COL_BULL : COL_BEAR
    label.new(bar_index, vBull ? low : high, f_vsaName(vsaCode),
         style = vBull ? label.style_label_up : label.style_label_down,
         color = color.new(vCol, 35), textcolor = color.white, size = size.tiny,
         tooltip = f_vsaTip(vsaCode))

int volCode = not hasVol ? 0 : vUltra ? 4 : vHigh ? 3 : vLow ? 1 : 2

// ══════════════════════ 3 · Wyckoff — phases and events ═════════════════════
// Phase: 0 none · 1 acc. forming · 2 accumulation · 3 dist. forming ·
//        4 distribution · 5 markup · 6 markdown
bool wyOn = showWy and hasVol

var int   wyPhase = 0
var float rgHi = na
var float rgLo = na
var int   rgStart = na
var int   waitCnt = 0
var int   rgAge = 0
var box   wyBox = na
var int   lastSpringBar = -100
var int   lastUtBar = -100

bool springEvt = false
bool utEvt = false
bool sosEvt = false
bool sowEvt = false

if wyOn and confirmed
    if wyPhase == 0 or wyPhase == 5 or wyPhase == 6
        // A climax against the prevailing trend seeds a potential range
        if scRaw and dowTrend <= 0
            wyPhase := 1
            rgHi := high
            rgLo := low
            rgStart := bar_index
            waitCnt := 0
        else if bcRaw and dowTrend >= 0
            wyPhase := 3
            rgHi := high
            rgLo := low
            rgStart := bar_index
            waitCnt := 0
    else if wyPhase == 1 or wyPhase == 3
        // Automatic rally/reaction window defines the range extremes
        rgHi := math.max(rgHi, high)
        rgLo := math.min(rgLo, low)
        waitCnt += 1
        if waitCnt >= arBars
            bool acc = wyPhase == 1
            wyPhase := acc ? 2 : 4
            rgAge := 0
            if showRangeBox
                wyBox := box.new(rgStart, rgHi, bar_index, rgLo,
                     border_color = color.new(acc ? COL_BULL : COL_DIST, 30),
                     bgcolor = color.new(acc ? COL_BULL : COL_DIST, 92),
                     border_width = 1)
    else if wyPhase == 2 or wyPhase == 4
        rgAge += 1
        if not na(wyBox)
            box.set_right(wyBox, bar_index)
            box.set_top(wyBox, rgHi)
            box.set_bottom(wyBox, rgLo)
        if low < rgLo and close > rgLo and not vUltra and bar_index - lastSpringBar > 5
            springEvt := true
            lastSpringBar := bar_index
            label.new(bar_index, low, "Spring", style = label.style_label_up,
                 color = color.new(COL_BULL, 15), textcolor = color.white, size = size.small,
                 tooltip = "Spring — price dipped below the trading-range low but closed back inside on non-climactic volume. Classic shakeout before markup.")
        else if high > rgHi and close < rgHi and (vHigh or vUltra) and bar_index - lastUtBar > 5
            utEvt := true
            lastUtBar := bar_index
            label.new(bar_index, high, "UT", style = label.style_label_down,
                 color = color.new(COL_BEAR, 15), textcolor = color.white, size = size.small,
                 tooltip = "Upthrust — price poked above the trading-range high but closed back inside on high volume. Classic distribution event before markdown.")
        else if close > rgHi and upClose and (vHigh or wideS)
            sosEvt := true
            wyPhase := 5
            label.new(bar_index, low, "SOS", style = label.style_label_up,
                 color = color.new(COL_BULL, 15), textcolor = color.white, size = size.small,
                 tooltip = "Sign of Strength — wide, high-volume close above the trading range. Markup beginning.")
            wyBox := box(na)
        else if close < rgLo and dnClose and (vHigh or wideS)
            sowEvt := true
            wyPhase := 6
            label.new(bar_index, high, "SOW", style = label.style_label_down,
                 color = color.new(COL_BEAR, 15), textcolor = color.white, size = size.small,
                 tooltip = "Sign of Weakness — wide, high-volume close below the trading range. Markdown beginning.")
            wyBox := box(na)
        else
            // Quiet drift outside the range widens it instead of signalling
            if close > rgHi
                rgHi := close
            if close < rgLo
                rgLo := close
        if (wyPhase == 2 or wyPhase == 4) and rgAge > maxRangeBars
            wyPhase := 0
            wyBox := box(na)
    // Markup/markdown context expires when structure turns against it
    if wyPhase == 5 and dowTrend == -1
        wyPhase := 0
    if wyPhase == 6 and dowTrend == 1
        wyPhase := 0

// ══════════════════════ 4 · Multi-timeframe context ═════════════════════════
string htf1 = htf1Auto ? f_autoTf(4) : htf1Fixed
string htf2 = htf2Auto ? f_autoTf(16) : htf2Fixed

int vsaAgo = na(lastVsaBar) ? int(na) : bar_index - lastVsaBar

// [1] + lookahead_on returns the last COMPLETED higher-timeframe bar's values:
// non-repainting on both historical and realtime bars.
[t1Raw, w1Raw, v1Raw, a1Raw, vc1Raw] = request.security(syminfo.tickerid, htf1,
     [dowTrend[1], wyPhase[1], lastVsa[1], vsaAgo[1], volCode[1]], lookahead = barmerge.lookahead_on)
[t2Raw, w2Raw, v2Raw, a2Raw, vc2Raw] = request.security(syminfo.tickerid, htf2,
     [dowTrend[1], wyPhase[1], lastVsa[1], vsaAgo[1], volCode[1]], lookahead = barmerge.lookahead_on)

int t1 = nz(t1Raw)
int t2 = nz(t2Raw)

// ══════════════════════ Confluence setups ═══════════════════════════════════
int confl = dowTrend + t1 + t2

bool bullTrig = springEvt or sosEvt or nsBar or tstBar or svBar or soVsa
bool bearTrig = utEvt or sowEvt or ndBar or utVsa or bcBar
bool longSetup  = showSignals and confirmed and bullTrig and t1 + t2 > 0 and dowTrend >= 0
bool shortSetup = showSignals and confirmed and bearTrig and t1 + t2 < 0 and dowTrend <= 0

// ══════════════════════ Chart output ════════════════════════════════════════
plotshape(showDow and showBos and bosUp, "BOS up", style = shape.diamond,
     location = location.belowbar, color = COL_BULL, size = size.tiny, text = "BOS", textcolor = COL_BULL)
plotshape(showDow and showBos and bosDn, "BOS down", style = shape.diamond,
     location = location.abovebar, color = COL_BEAR, size = size.tiny, text = "BOS", textcolor = COL_BEAR)

plotshape(longSetup, "Long confluence setup", style = shape.triangleup,
     location = location.belowbar, color = COL_BULL, size = size.small, text = "Long", textcolor = COL_BULL)
plotshape(shortSetup, "Short confluence setup", style = shape.triangledown,
     location = location.abovebar, color = COL_BEAR, size = size.small, text = "Short", textcolor = COL_BEAR)

bgcolor(showDow and showTrendBg ? dowTrend == 1 ? color.new(COL_BULL, 92) :
     dowTrend == -1 ? color.new(COL_BEAR, 92) : na : na, title = "Trend background")

// ══════════════════════ Dashboard ═══════════════════════════════════════════
string tablePos = dashPos == "Top left" ? position.top_left :
     dashPos == "Bottom right" ? position.bottom_right :
     dashPos == "Bottom left" ? position.bottom_left :
     dashPos == "Middle right" ? position.middle_right : position.top_right
string txtSz = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

color DASH_TXT = color.white
color DASH_HDR = #b2b5be

var table dash = na

if showDash and barstate.islast
    if na(dash)
        dash := table.new(tablePos, 5, 5, bgcolor = color.new(#000000, 72),
             frame_color = color.new(#787b86, 40), frame_width = 1,
             border_color = color.new(#787b86, 75), border_width = 1)
        table.merge_cells(dash, 1, 4, 4, 4)
    // header
    table.cell(dash, 0, 0, "TF",      text_color = DASH_HDR, text_size = txtSz)
    table.cell(dash, 1, 0, "Trend",   text_color = DASH_HDR, text_size = txtSz)
    table.cell(dash, 2, 0, "Wyckoff", text_color = DASH_HDR, text_size = txtSz)
    table.cell(dash, 3, 0, "VSA",     text_color = DASH_HDR, text_size = txtSz)
    table.cell(dash, 4, 0, "Vol",     text_color = DASH_HDR, text_size = txtSz)
    // chart timeframe
    string vTxt0 = lastVsa == 0 ? "—" : f_vsaName(lastVsa) + (na(vsaAgo) ? "" : " ·" + str.tostring(vsaAgo))
    table.cell(dash, 0, 1, f_tfTxt(timeframe.period), text_color = DASH_TXT, text_size = txtSz, tooltip = "Chart timeframe")
    table.cell(dash, 1, 1, f_trendTxt(dowTrend), text_color = f_trendCol(dowTrend), text_size = txtSz)
    table.cell(dash, 2, 1, f_wyTxt(wyPhase, dowTrend), text_color = DASH_TXT, text_size = txtSz)
    table.cell(dash, 3, 1, vTxt0, text_color = DASH_TXT, text_size = txtSz, tooltip = "Last VSA signal · bars ago")
    table.cell(dash, 4, 1, f_volTxt(volCode), text_color = volCode >= 3 ? COL_DIST : DASH_TXT, text_size = txtSz)
    // higher timeframe 1
    bool htf1Low = timeframe.in_seconds(htf1) <= timeframe.in_seconds(timeframe.period)
    string vTxt1 = nz(v1Raw) == 0 ? "—" : f_vsaName(nz(v1Raw)) + (na(a1Raw) ? "" : " ·" + str.tostring(nz(a1Raw)))
    table.cell(dash, 0, 2, f_tfTxt(htf1), text_color = htf1Low ? COL_DIST : DASH_TXT, text_size = txtSz,
         tooltip = htf1Low ? "Should be higher than the chart timeframe" : "Higher timeframe 1")
    table.cell(dash, 1, 2, f_trendTxt(t1), text_color = f_trendCol(t1), text_size = txtSz)
    table.cell(dash, 2, 2, f_wyTxt(nz(w1Raw), t1), text_color = DASH_TXT, text_size = txtSz)
    table.cell(dash, 3, 2, vTxt1, text_color = DASH_TXT, text_size = txtSz, tooltip = "Last VSA signal · HTF bars ago")
    table.cell(dash, 4, 2, f_volTxt(nz(vc1Raw)), text_color = DASH_TXT, text_size = txtSz)
    // higher timeframe 2
    bool htf2Low = timeframe.in_seconds(htf2) <= timeframe.in_seconds(timeframe.period)
    string vTxt2 = nz(v2Raw) == 0 ? "—" : f_vsaName(nz(v2Raw)) + (na(a2Raw) ? "" : " ·" + str.tostring(nz(a2Raw)))
    table.cell(dash, 0, 3, f_tfTxt(htf2), text_color = htf2Low ? COL_DIST : DASH_TXT, text_size = txtSz,
         tooltip = htf2Low ? "Should be higher than the chart timeframe" : "Higher timeframe 2")
    table.cell(dash, 1, 3, f_trendTxt(t2), text_color = f_trendCol(t2), text_size = txtSz)
    table.cell(dash, 2, 3, f_wyTxt(nz(w2Raw), t2), text_color = DASH_TXT, text_size = txtSz)
    table.cell(dash, 3, 3, vTxt2, text_color = DASH_TXT, text_size = txtSz, tooltip = "Last VSA signal · HTF bars ago")
    table.cell(dash, 4, 3, f_volTxt(nz(vc2Raw)), text_color = DASH_TXT, text_size = txtSz)
    // confluence
    string cTxt = confl >= 2 ? "BULLISH ALIGNMENT" : confl <= -2 ? "BEARISH ALIGNMENT" : "MIXED / WAIT"
    color cCol = confl >= 2 ? COL_BULL : confl <= -2 ? COL_BEAR : COL_NEUT
    table.cell(dash, 0, 4, "Bias", text_color = DASH_HDR, text_size = txtSz)
    table.cell(dash, 1, 4, cTxt, text_color = cCol, text_size = txtSz,
         tooltip = "Chart + HTF1 + HTF2 trend score (each ±1)")

// ══════════════════════ Alerts ══════════════════════════════════════════════
bool trendUpEvt = dowTrend == 1 and dowTrend[1] != 1
bool trendDnEvt = dowTrend == -1 and dowTrend[1] != -1

alertcondition(trendUpEvt, "Dow trend turned UP", "DWVM: Dow structure turned UP on {{ticker}} {{interval}}")
alertcondition(trendDnEvt, "Dow trend turned DOWN", "DWVM: Dow structure turned DOWN on {{ticker}} {{interval}}")
alertcondition(springEvt, "Wyckoff Spring", "DWVM: Wyckoff Spring on {{ticker}} {{interval}}")
alertcondition(utEvt, "Wyckoff Upthrust", "DWVM: Wyckoff Upthrust on {{ticker}} {{interval}}")
alertcondition(sosEvt, "Wyckoff Sign of Strength", "DWVM: Sign of Strength — range breakout on {{ticker}} {{interval}}")
alertcondition(sowEvt, "Wyckoff Sign of Weakness", "DWVM: Sign of Weakness — range breakdown on {{ticker}} {{interval}}")
alertcondition(nsBar, "VSA No Supply", "DWVM: VSA No Supply bar on {{ticker}} {{interval}}")
alertcondition(ndBar, "VSA No Demand", "DWVM: VSA No Demand bar on {{ticker}} {{interval}}")
alertcondition(scBar or bcBar, "VSA Climactic volume", "DWVM: climactic volume (SC/BC) on {{ticker}} {{interval}}")
alertcondition(longSetup, "Long confluence setup", "DWVM: LONG confluence setup on {{ticker}} {{interval}}")
alertcondition(shortSetup, "Short confluence setup", "DWVM: SHORT confluence setup on {{ticker}} {{interval}}")
