# Copy to .env and adjust for production.

# Port the server listens on.
PORT=3000

# REQUIRED in production. Signs the visitor cookie. Use a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
SESSION_SECRET=

# Set to 'production' to require SESSION_SECRET and mark cookies Secure.
NODE_ENV=development

# Optional. When set, enables the moderation endpoints:
#   GET    /api/admin/reports     (header: x-admin-key: <ADMIN_KEY>)
#   DELETE /api/admin/photo/:id   (header: x-admin-key: <ADMIN_KEY>)
# Leave blank to keep moderation endpoints disabled.
ADMIN_KEY=

# Optional storage locations (default to ./data and ./uploads next to the app).
# DATA_DIR=/var/lib/ratemysoles/data
# UPLOAD_DIR=/var/lib/ratemysoles/uploads
